{
  "name": "slotly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/local.sql",
    "auth:hash:demo": "vite-node scripts/generate-demo-passwords.ts",
    "auth:hash:admin": "vite-node scripts/hash-admin.ts",
    "auth:bench": "vite-node scripts/benchmark-password.ts",
    "admin:reset": "vite-node scripts/reset-admin-password.ts",
    "staff:create": "vite-node scripts/create-staff.ts",
    "services:create": "vite-node scripts/create-services.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "hono": "^4.13.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.163.0"
  }
}
